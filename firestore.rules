rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Reusable Security Primitives ---
    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isAdmin() {
      return isVerifiedUser() && request.auth.token.email == 'prabhuaj8@gmail.com';
    }

    function isOwner(uid) {
      return isVerifiedUser() && isValidId(uid) && request.auth.uid == uid;
    }

    function isNotBlocked() {
      return !exists(/databases/$(database)/documents/blockedUsers/$(request.auth.uid));
    }

    function isValidLang(lang) {
      return lang is string && lang in ['hinglish', 'hindi', 'english'];
    }

    // --- Validation Blueprints ---
    function isValidUserProfile(data, uid) {
      return data.keys().hasAll(['uid', 'username', 'email', 'preferredLanguage', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly([
          'uid', 'username', 'email', 'avatarUrl', 'preferredLanguage',
          'role', 'status', 'blockedReason', 'blockedAt', 'blockedBy',
          'lastLoginAt', 'createdAt', 'updatedAt'
        ])
        && data.uid is string && data.uid == uid
        && data.username is string && data.username.size() >= 1 && data.username.size() <= 64
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 254
        && (!('avatarUrl' in data) || (data.avatarUrl is string && data.avatarUrl.size() <= 512))
        && isValidLang(data.preferredLanguage)
        && (!('role' in data) || (data.role is string && data.role in ['user', 'admin']))
        && (!('status' in data) || (data.status is string && data.status in ['active', 'blocked']))
        && (!('blockedReason' in data) || (data.blockedReason is string && data.blockedReason.size() <= 500))
        && (!('blockedAt' in data) || data.blockedAt is timestamp)
        && (!('blockedBy' in data) || (data.blockedBy is string && data.blockedBy.size() <= 128))
        && (!('lastLoginAt' in data) || data.lastLoginAt is timestamp)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidBlockedUser(data, uid) {
      return data.keys().hasAll(['uid', 'email', 'reason', 'blockedBy', 'blockedAt'])
        && data.keys().hasOnly(['uid', 'email', 'reason', 'blockedBy', 'blockedAt'])
        && data.uid is string && data.uid == uid
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 254
        && data.reason is string && data.reason.size() <= 500
        && data.blockedBy is string && data.blockedBy == request.auth.uid
        && data.blockedAt is timestamp;
    }

    function isValidAppSettings(data) {
      return data.keys().hasAll([
        'appName', 'allowRegistrations', 'maintenanceMode',
        'announcementEnabled', 'themeMode', 'accentColor', 'updatedAt'
      ])
        && data.keys().hasOnly([
          'appName', 'appSubtitle', 'logoUrl', 'supportEmail', 'supportNote',
          'allowRegistrations', 'registrationClosedMessage',
          'maintenanceMode', 'maintenanceMessage',
          'announcementEnabled', 'announcementTitle', 'announcementMessage', 'announcementType',
          'themeMode', 'accentColor', 'enableVoiceInput', 'enableAiSuggestions',
          'updatedBy', 'updatedAt'
        ])
        && data.appName is string && data.appName.size() >= 1 && data.appName.size() <= 80
        && (!('appSubtitle' in data) || (data.appSubtitle is string && data.appSubtitle.size() <= 200))
        && (!('logoUrl' in data) || (data.logoUrl is string && data.logoUrl.size() <= 512))
        && (!('supportEmail' in data) || (data.supportEmail is string && data.supportEmail.size() <= 254))
        && (!('supportNote' in data) || (data.supportNote is string && data.supportNote.size() <= 500))
        && data.allowRegistrations is bool
        && (!('registrationClosedMessage' in data) || (data.registrationClosedMessage is string && data.registrationClosedMessage.size() <= 300))
        && data.maintenanceMode is bool
        && (!('maintenanceMessage' in data) || (data.maintenanceMessage is string && data.maintenanceMessage.size() <= 500))
        && data.announcementEnabled is bool
        && (!('announcementTitle' in data) || (data.announcementTitle is string && data.announcementTitle.size() <= 120))
        && (!('announcementMessage' in data) || (data.announcementMessage is string && data.announcementMessage.size() <= 500))
        && (!('announcementType' in data) || (data.announcementType is string && data.announcementType in ['info', 'warning', 'success']))
        && data.themeMode is string && data.themeMode in ['dark', 'light']
        && data.accentColor is string && data.accentColor.size() >= 4 && data.accentColor.size() <= 16
        && (!('enableVoiceInput' in data) || data.enableVoiceInput is bool)
        && (!('enableAiSuggestions' in data) || data.enableAiSuggestions is bool)
        && (!('updatedBy' in data) || (data.updatedBy is string && data.updatedBy.size() <= 128))
        && data.updatedAt is timestamp;
    }

    function isValidAppContent(data) {
      return data.keys().hasAll(['welcomeHeading', 'welcomeSubheading', 'updatedAt'])
        && data.keys().hasOnly([
          'welcomeHeading', 'welcomeSubheading', 'heroBadgeText',
          'homeFeaturedTitle', 'guestPromptTitle', 'guestPromptSubtitle',
          'helpGuideText', 'footerNote', 'updatedBy', 'updatedAt'
        ])
        && data.welcomeHeading is string && data.welcomeHeading.size() >= 1 && data.welcomeHeading.size() <= 140
        && data.welcomeSubheading is string && data.welcomeSubheading.size() <= 400
        && (!('heroBadgeText' in data) || (data.heroBadgeText is string && data.heroBadgeText.size() <= 80))
        && (!('homeFeaturedTitle' in data) || (data.homeFeaturedTitle is string && data.homeFeaturedTitle.size() <= 100))
        && (!('guestPromptTitle' in data) || (data.guestPromptTitle is string && data.guestPromptTitle.size() <= 140))
        && (!('guestPromptSubtitle' in data) || (data.guestPromptSubtitle is string && data.guestPromptSubtitle.size() <= 400))
        && (!('helpGuideText' in data) || (data.helpGuideText is string && data.helpGuideText.size() <= 1500))
        && (!('footerNote' in data) || (data.footerNote is string && data.footerNote.size() <= 300))
        && (!('updatedBy' in data) || (data.updatedBy is string && data.updatedBy.size() <= 128))
        && data.updatedAt is timestamp;
    }

    function isValidPreferences(data, uid) {
      return data.keys().hasAll(['uid', 'language', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'language', 'autoScroll', 'soundEffects', 'updatedAt'])
        && data.uid is string && data.uid == uid
        && isValidLang(data.language)
        && (!('autoScroll' in data) || data.autoScroll is bool)
        && (!('soundEffects' in data) || data.soundEffects is bool)
        && data.updatedAt is timestamp;
    }

    function isValidFavorite(data, uid, storyId) {
      return data.keys().hasAll(['uid', 'storyId', 'title', 'createdAt'])
        && data.keys().hasOnly(['uid', 'storyId', 'title', 'coverImage', 'genre', 'createdAt'])
        && data.uid is string && data.uid == uid
        && data.storyId is string && data.storyId == storyId
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 140
        && (!('coverImage' in data) || (data.coverImage is string && data.coverImage.size() <= 512))
        && (!('genre' in data) || (data.genre is string && data.genre.size() <= 64))
        && data.createdAt is timestamp;
    }

    function isValidStoryProgress(data, uid, storyId) {
      return data.keys().hasAll(['uid', 'storyId', 'currentScene', 'sceneIndex', 'status', 'startedAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'storyId', 'currentScene', 'sceneIndex', 'status', 'endingReached', 'choicesMade', 'savedCharacterIds', 'startedAt', 'updatedAt'])
        && data.uid is string && data.uid == uid
        && data.storyId is string && data.storyId == storyId
        && data.currentScene is string && data.currentScene.size() >= 1 && data.currentScene.size() <= 500
        && data.sceneIndex is int && data.sceneIndex >= 0 && data.sceneIndex <= 1000
        && data.status is string && data.status in ['active', 'completed']
        && (!('endingReached' in data) || (data.endingReached is string && data.endingReached.size() <= 200))
        && (!('choicesMade' in data) || (data.choicesMade is list && data.choicesMade.size() <= 50 && (data.choicesMade.size() == 0 || data.choicesMade[0] is string)))
        && (!('savedCharacterIds' in data) || (data.savedCharacterIds is list && data.savedCharacterIds.size() <= 30 && (data.savedCharacterIds.size() == 0 || data.savedCharacterIds[0] is string)))
        && data.startedAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidConversation(data, uid, conversationId) {
      return data.keys().hasAll(['uid', 'conversationId', 'storyId', 'storyTitle', 'lastMessage', 'messageCount', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'conversationId', 'storyId', 'storyTitle', 'coverImage', 'lastMessage', 'lastSpeaker', 'messageCount', 'createdAt', 'updatedAt'])
        && data.uid is string && data.uid == uid
        && data.conversationId is string && data.conversationId == conversationId
        && isValidId(data.storyId)
        && data.storyTitle is string && data.storyTitle.size() >= 1 && data.storyTitle.size() <= 140
        && (!('coverImage' in data) || (data.coverImage is string && data.coverImage.size() <= 512))
        && data.lastMessage is string && data.lastMessage.size() <= 1000
        && (!('lastSpeaker' in data) || (data.lastSpeaker is string && data.lastSpeaker.size() <= 100))
        && data.messageCount is int && data.messageCount >= 0 && data.messageCount <= 50000
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidChatMessage(data, uid, conversationId) {
      return data.keys().hasAll(['uid', 'conversationId', 'role', 'sequence', 'createdAt'])
        && data.keys().hasOnly(['uid', 'conversationId', 'role', 'userText', 'sceneSummary', 'beats', 'metersSnapshot', 'sequence', 'createdAt'])
        && data.uid is string && data.uid == uid
        && data.conversationId is string && data.conversationId == conversationId
        && data.role is string && data.role in ['user', 'story']
        && (!('userText' in data) || (data.userText is string && data.userText.size() <= 4000))
        && (!('sceneSummary' in data) || (data.sceneSummary is string && data.sceneSummary.size() <= 500))
        && (!('beats' in data) || (data.beats is list && data.beats.size() <= 12 && (data.beats.size() == 0 || data.beats[0] is map)))
        && (!('metersSnapshot' in data) || (data.metersSnapshot is list && data.metersSnapshot.size() <= 10 && (data.metersSnapshot.size() == 0 || data.metersSnapshot[0] is map)))
        && data.sequence is int && data.sequence >= 0 && data.sequence <= 100000
        && data.createdAt is timestamp;
    }

    function isValidRelationship(data, uid, storyId) {
      return data.keys().hasAll(['uid', 'storyId', 'meters', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'storyId', 'meters', 'updatedAt'])
        && data.uid is string && data.uid == uid
        && data.storyId is string && data.storyId == storyId
        && data.meters is list && data.meters.size() <= 12 && (data.meters.size() == 0 || data.meters[0] is map)
        && data.updatedAt is timestamp;
    }

    function isValidMemory(data, uid) {
      return data.keys().hasAll(['uid', 'storyId', 'summary', 'importance', 'createdAt'])
        && data.keys().hasOnly(['uid', 'storyId', 'summary', 'importance', 'charactersInvolved', 'createdAt'])
        && data.uid is string && data.uid == uid
        && isValidId(data.storyId)
        && data.summary is string && data.summary.size() >= 1 && data.summary.size() <= 600
        && data.importance is int && data.importance >= 1 && data.importance <= 10
        && (!('charactersInvolved' in data) || (data.charactersInvolved is list && data.charactersInvolved.size() <= 10 && (data.charactersInvolved.size() == 0 || data.charactersInvolved[0] is string)))
        && data.createdAt is timestamp;
    }

    function isValidManagedStory(data, storyId) {
      return data.keys().hasAll(['id', 'title', 'tagline', 'about', 'primaryCategory', 'tags', 'coverImage', 'published', 'createdBy', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'title', 'tagline', 'about', 'primaryCategory', 'tags', 'coverImage', 'mediaGallery', 'characters', 'openingScene', 'openingBeats', 'relationshipMeters', 'published', 'createdBy', 'createdAt', 'updatedAt'])
        && data.id is string && data.id == storyId
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 140
        && data.tagline is string && data.tagline.size() <= 300
        && data.about is string && data.about.size() <= 3000
        && data.primaryCategory is string && data.primaryCategory.size() >= 1 && data.primaryCategory.size() <= 64
        && data.tags is list && data.tags.size() <= 10 && (data.tags.size() == 0 || data.tags[0] is string)
        && data.coverImage is string && data.coverImage.size() <= 1024
        && (!('mediaGallery' in data) || (data.mediaGallery is list && data.mediaGallery.size() <= 20 && (data.mediaGallery.size() == 0 || data.mediaGallery[0] is string)))
        && (!('characters' in data) || (data.characters is list && data.characters.size() <= 10 && (data.characters.size() == 0 || data.characters[0] is map)))
        && (!('openingScene' in data) || (data.openingScene is string && data.openingScene.size() <= 1000))
        && (!('openingBeats' in data) || (data.openingBeats is list && data.openingBeats.size() <= 10 && (data.openingBeats.size() == 0 || data.openingBeats[0] is map)))
        && (!('relationshipMeters' in data) || (data.relationshipMeters is list && data.relationshipMeters.size() <= 10 && (data.relationshipMeters.size() == 0 || data.relationshipMeters[0] is map)))
        && data.published is bool
        && data.createdBy is string && data.createdBy.size() >= 1 && data.createdBy.size() <= 128
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // --- Collection Rules ---
    match /users/{uid} {
      allow get: if isOwner(uid) || isAdmin();
      allow list: if isAdmin();
      allow create: if isOwner(uid)
        && isNotBlocked()
        && isValidUserProfile(incoming(), uid)
        && (!('role' in incoming()) || incoming().role == 'user' || (isAdmin() && incoming().role == 'admin'))
        && (!('status' in incoming()) || incoming().status == 'active')
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(uid) && isValidUserProfile(incoming(), uid) && (
        // Tier 1: Owning user edits safe profile/preference fields only (cannot edit role or status)
        (
          isOwner(uid)
          && isNotBlocked()
          && incoming().uid == existing().uid
          && incoming().email == existing().email
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['username', 'avatarUrl', 'preferredLanguage', 'lastLoginAt', 'updatedAt'])
        ) ||
        // Tier 2: Main Admin manages block status for other users (cannot block self or escalate roles)
        (
          isAdmin()
          && uid != request.auth.uid
          && incoming().uid == existing().uid
          && incoming().email == existing().email
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'blockedReason', 'blockedAt', 'blockedBy', 'updatedAt'])
        )
      );
      allow delete: if isOwner(uid);

      match /preferences/{prefId} {
        allow get: if isOwner(uid) && isValidId(prefId);
        allow list: if isOwner(uid) && resource.data.uid == request.auth.uid;
        allow create: if isOwner(uid) && isNotBlocked() && isValidId(prefId)
          && isValidPreferences(incoming(), uid)
          && incoming().updatedAt == request.time;
        allow update: if isOwner(uid) && isNotBlocked() && isValidId(prefId)
          && isValidPreferences(incoming(), uid)
          && incoming().uid == existing().uid
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['language', 'autoScroll', 'soundEffects', 'updatedAt']);
        allow delete: if isOwner(uid) && isValidId(prefId);
      }

      match /favorites/{storyId} {
        allow get: if isOwner(uid) && isValidId(storyId);
        allow list: if isOwner(uid) && resource.data.uid == request.auth.uid;
        allow create: if isOwner(uid) && isNotBlocked() && isValidId(storyId)
          && isValidFavorite(incoming(), uid, storyId)
          && incoming().createdAt == request.time;
        allow update: if false;
        allow delete: if isOwner(uid) && isNotBlocked() && isValidId(storyId);
      }

      match /storyProgress/{storyId} {
        allow get: if isOwner(uid) && isValidId(storyId);
        allow list: if isOwner(uid) && resource.data.uid == request.auth.uid;
        allow create: if isOwner(uid) && isNotBlocked() && isValidId(storyId)
          && isValidStoryProgress(incoming(), uid, storyId)
          && incoming().startedAt == request.time
          && incoming().updatedAt == request.time;
        allow update: if isOwner(uid) && isNotBlocked() && isValidId(storyId)
          && isValidStoryProgress(incoming(), uid, storyId)
          && incoming().uid == existing().uid
          && incoming().storyId == existing().storyId
          && incoming().startedAt == existing().startedAt
          && incoming().updatedAt == request.time
          && (
            existing().status != 'completed' ||
            incoming().status == 'active'
          )
          && incoming().diff(existing()).affectedKeys().hasOnly(['currentScene', 'sceneIndex', 'status', 'endingReached', 'choicesMade', 'savedCharacterIds', 'updatedAt']);
        allow delete: if isOwner(uid) && isNotBlocked() && isValidId(storyId);
      }

      match /conversations/{conversationId} {
        allow get: if isOwner(uid) && isValidId(conversationId);
        allow list: if isOwner(uid) && resource.data.uid == request.auth.uid;
        allow create: if isOwner(uid) && isNotBlocked() && isValidId(conversationId)
          && isValidConversation(incoming(), uid, conversationId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;
        allow update: if isOwner(uid) && isNotBlocked() && isValidId(conversationId)
          && isValidConversation(incoming(), uid, conversationId)
          && incoming().uid == existing().uid
          && incoming().conversationId == existing().conversationId
          && incoming().storyId == existing().storyId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['lastMessage', 'lastSpeaker', 'messageCount', 'updatedAt']);
        allow delete: if isOwner(uid) && isNotBlocked() && isValidId(conversationId);

        match /messages/{messageId} {
          allow get: if isOwner(uid) && isValidId(conversationId) && isValidId(messageId)
            && exists(/databases/$(database)/documents/users/$(uid)/conversations/$(conversationId));
          allow list: if isOwner(uid) && resource.data.uid == request.auth.uid;
          allow create: if isOwner(uid) && isNotBlocked() && isValidId(conversationId) && isValidId(messageId)
            && isValidChatMessage(incoming(), uid, conversationId)
            && incoming().createdAt == request.time
            && existsAfter(/databases/$(database)/documents/users/$(uid)/conversations/$(conversationId));
          allow update: if false;
          allow delete: if isOwner(uid) && isNotBlocked() && isValidId(conversationId) && isValidId(messageId);
        }
      }

      match /relationships/{storyId} {
        allow get: if isOwner(uid) && isValidId(storyId);
        allow list: if isOwner(uid) && resource.data.uid == request.auth.uid;
        allow create: if isOwner(uid) && isNotBlocked() && isValidId(storyId)
          && isValidRelationship(incoming(), uid, storyId)
          && incoming().updatedAt == request.time;
        allow update: if isOwner(uid) && isNotBlocked() && isValidId(storyId)
          && isValidRelationship(incoming(), uid, storyId)
          && incoming().uid == existing().uid
          && incoming().storyId == existing().storyId
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['meters', 'updatedAt']);
        allow delete: if isOwner(uid) && isNotBlocked() && isValidId(storyId);
      }

      match /memories/{memoryId} {
        allow get: if isOwner(uid) && isValidId(memoryId);
        allow list: if isOwner(uid) && resource.data.uid == request.auth.uid;
        allow create: if isOwner(uid) && isNotBlocked() && isValidId(memoryId)
          && isValidMemory(incoming(), uid)
          && incoming().createdAt == request.time;
        allow update: if false;
        allow delete: if isOwner(uid) && isNotBlocked() && isValidId(memoryId);
      }
    }

    match /blockedUsers/{uid} {
      allow get: if isOwner(uid) || isAdmin();
      allow list: if isAdmin();
      allow create, update: if isAdmin()
        && isValidId(uid)
        && uid != request.auth.uid
        && isValidBlockedUser(incoming(), uid)
        && incoming().blockedAt == request.time;
      allow delete: if isAdmin() && isValidId(uid);
    }

    match /appConfig/{docId} {
      allow get: if isValidId(docId) && docId in ['settings', 'content'];
      allow list: if isAdmin();
      allow create, update: if isAdmin() && isValidId(docId) && (
        (docId == 'settings' && isValidAppSettings(incoming()) && incoming().updatedAt == request.time) ||
        (docId == 'content' && isValidAppContent(incoming()) && incoming().updatedAt == request.time)
      );
      allow delete: if isAdmin() && isValidId(docId) && docId in ['settings', 'content'];
    }

    match /stories/{storyId} {
      allow get: if isValidId(storyId) && (existing().published == true || isAdmin());
      allow list: if resource.data.published == true || isAdmin();
      allow create: if isAdmin() && isValidId(storyId)
        && isValidManagedStory(incoming(), storyId)
        && incoming().createdBy == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isAdmin() && isValidId(storyId)
        && isValidManagedStory(incoming(), storyId)
        && incoming().id == existing().id
        && incoming().createdBy == existing().createdBy
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time;
      allow delete: if isAdmin() && isValidId(storyId);
    }
  }
}
